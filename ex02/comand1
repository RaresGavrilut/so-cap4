#!/bin/bash
# Problema 2 - comand1
# Primeste 2 parametri: S (subdirector) si FILE (fisier fara extensie).
# Creeaza S, intra in S, apeleaza OPTIUNE si, in functie de valoare:
#   1 - creeaza prin copiere de la tastatura FILE.TXT
#   2 - sorteaza FILE.TXT in FILE.SRT
#   3 - afiseaza FILE.SRT
# Daca valoarea e diferita de 0, apeleaza din nou OPTIUNE.
# La final afiseaza directorul curent si revine in directorul parinte.

# Scrieti solutia mai jos:
S="$1"
FILE="$2"

if [ -z "$S" ] || [ -z "$FILE" ]; then
    echo "Utilizare: $0 S FILE"
    exit 1
fi

mkdir -p "$S"
cd "$S" || exit 1

./OPTIUNE
opt=$?

while [ "$opt" -ne 0 ]; do
    case "$opt" in
        1)
            echo "Introduceti continutul pentru ${FILE}.TXT (Ctrl+D pentru a termina):"
            cat > "${FILE}.TXT"
            ;;
        2)
            if [ -f "${FILE}.TXT" ]; then
                sort "${FILE}.TXT" > "${FILE}.SRT"
                echo "Sortat in ${FILE}.SRT"
            else
                echo "Fisierul ${FILE}.TXT nu exista."
            fi
            ;;
        3)
            if [ -f "${FILE}.SRT" ]; then
                cat "${FILE}.SRT"
            else
                echo "Fisierul ${FILE}.SRT nu exista."
            fi
            ;;
        *)
            echo "Optiune necunoscuta: $opt"
            ;;
    esac

    ./OPTIUNE
    opt=$?
done

pwd
cd ..

